{
  "name": "log-log-legends",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev -p 8765",
    "build": "next build && node scripts/agent-files.mjs",
    "preview": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:components && npm run build && node --test 'tests/*.test.mjs'",
    "test:components": "node --import tsx --test 'tests/components/*.test.tsx'",
    "kit:states": "node scripts/kit-states.mjs",
    "parity:build": "node scripts/parity/build-ref.mjs",
    "parity:static": "node scripts/parity/static.mjs",
    "parity:runtime": "node scripts/parity/runtime.mjs",
    "parity:faults": "node scripts/parity/faults.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "global-jsdom": "^30.0.0",
    "jsdom": "^30.1.2",
    "linkedom": "^0.18.13",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~6.0.3"
  }
}
