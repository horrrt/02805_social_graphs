  "buildCmd": ".design-sync/pkg/build.sh",
  "srcDir": "../../src/kit",
  "tsconfig": "tsconfig.json",
  "cssEntry": "gen/site.css",
  "extraFonts": [
    "../../src/styles/type.css"
